# ---- Server ----
PORT=4100
NODE_ENV=development
# Origins allowed to call the API with credentials (comma separated). In dev the Vite proxy is used, so this is mainly for prod.
CORS_ORIGINS=http://localhost:4173,http://localhost:5173
# Redis
REDIS_URL=redis://127.0.0.1:6379/5
REDIS_PREFIX=pwp:
# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Pair backend used when a widget's source is "api"
PAIR_API_BASE_URL=https://system.trypair.ai
PAIR_API_TIMEOUT_MS=8000
# Seed: initial admin + demo users (only created if they do not exist)
SEED_ADMIN_EMAIL=admin@pair.local
SEED_ADMIN_PASSWORD="Admin#12345"
SEED_USERS="designer@pair.local:Designer#12345:editor,viewer@pair.local:Viewer#12345:viewer"

# Widget SDK used by the embed snippet and the hosted preview page
WIDGET_SDK_BASE_URL=https://widgets-test.trypair.ai

# Optional: system logs are written to MongoDB when this is set.
# Leave it blank and the app still runs; logs are then kept in a capped Redis list.
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pair_widget_studio
MONGODB_TIMEOUT_MS=4000
MONGODB_LOG_TTL_DAYS=90

# Where uploaded widget media is stored (relative to the repo root)
UPLOAD_DIR=data/uploads

# Optional: a local build of the widget SDK to serve at /sdk, so widget changes
# are visible before the hosted SDK is redeployed. Blank = use WIDGET_SDK_BASE_URL.
WIDGET_SDK_DIST=
