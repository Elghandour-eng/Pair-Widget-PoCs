# ---- Server ----
PORT=4100
NODE_ENV=development
# Origins allowed to call the API with credentials (comma separated). In dev the Vite proxy is used, so this is mainly for prod.
CORS_ORIGINS=http://localhost:4173,http://localhost:5173
# Redis
REDIS_URL=redis://127.0.0.1:6379/5
REDIS_PREFIX=pwp:
# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Pair backend used when a widget's source is "api"
PAIR_API_BASE_URL=https://system.trypair.ai
PAIR_API_TIMEOUT_MS=8000
# Seed: initial admin + demo users, created at boot if they do not exist.
# Both the email and the password must be set for the admin to be created, so
# leaving the password blank here means a deployment copied from this file has
# no seeded accounts at all. Never deploy with a password written in this file:
# it is public, so it would be a published login for a live environment.
SEED_ADMIN_EMAIL=admin@pair.local
SEED_ADMIN_PASSWORD=
SEED_USERS=

# Optional: system logs are written to MongoDB when this is set.
# Leave it blank and the app still runs; logs are then kept in a capped Redis list.
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pair_widget_studio
MONGODB_TIMEOUT_MS=4000
MONGODB_LOG_TTL_DAYS=90

# Where uploaded widget media is stored (relative to the repo root)
UPLOAD_DIR=data/uploads

# ---- The widget SDK ----
# Two different things, and confusing them is the one mistake that fails
# silently:
#   WIDGET_SDK_DIST     — where the widget's own build sits on disk. Set, it is
#                         served at /sdk and every embed loads the widget from
#                         this same origin.
#   WIDGET_SDK_BASE_URL — a *foreign* origin to load the widget from instead.
#                         Only used when WIDGET_SDK_DIST holds no build.
#
# Pointing a deployment at a foreign origin means new config runs against
# whatever version that origin happens to be serving. Nothing errors: the page
# loads, the widget just is not the one this studio was built with. So keep
# WIDGET_SDK_BASE_URL empty unless you truly mean it, and let /sdk answer.
#
# Container deployments: the image builds sdk-src/ into /app/sdk-dist (see the
# Dockerfile's sdk stage), so this is the value to deploy with.
WIDGET_SDK_DIST=/app/sdk-dist
# Local development: build the widget in place and point this at it —
#   cd sdk-src && npm install && npx vite build --base=/sdk/ --outDir dist-local
#   WIDGET_SDK_DIST=sdk-src/dist-local
# sdk-src needs its own .env for the build (see sdk-src/.env.example): Vite bakes
# those values in, and the widget throws at startup if they are missing.

# Leave blank. See above.
WIDGET_SDK_BASE_URL=

# The widget's own settings. The image builds the widget without them; this
# server writes them into the widget's page at runtime, so they are runtime
# settings like everything above — in a deployment they come from Vault, and a
# change needs a restart, not a rebuild. The widget refuses to start without
# VITE_BASE_URL and VITE_PUSHER_APP_KEY. A blank value here falls back to
# whatever a local build baked in from sdk-src/.env.
VITE_BASE_URL=
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_FORCE_TLS=
VITE_HIRO_WIDGET_ID=

# --- Voice calls (LiveKit) ---------------------------------------------------
# The widget's phone button opens a call to a LiveKit voice agent. The server
# creates the room (tagged with the agent's number from the builder) and gives
# the widget a token for that room only. Leave all three blank to keep calls
# off; GET /api/health reports `livekit.configured`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The Pusher values must be the Pusher that PAIR_API_BASE_URL itself publishes
# on: the widget opens its socket with VITE_PUSHER_APP_KEY, and Pair signs the
# conversation channel with *its* key. Give the widget any other key (a Pusher
# cloud key, say, with VITE_PUSHER_HOST blank) and the Pusher server refuses the
# subscription while every HTTP call still succeeds: a message stays "Sending…"
# for ever and agent replies never arrive live. That mismatch is reported in
# GET /api/health under `pusher` (`mismatch: true`, with both keys masked) and
# once in the log, from the first channel subscription the widget makes.

# --- Cinescape concessions menu (Airtable) -----------------------------------
# The menu the widget renders under `menu_list` / `menu_categories`. With a
# token the server pages the whole table on boot and every MENU_REFRESH_MS,
# keeping the copy in memory and in Redis; a failed refresh keeps the last good
# copy. With no token it serves the compiled snapshot in
# server/src/routes/cinescapeMenu.ts, which drifts as soon as anyone edits
# Airtable. Which copy is answering is reported in GET /api/health under `menu`.
AIRTABLE_TOKEN=
AIRTABLE_MENU_BASE=appRkp6YvIgE5m69N
AIRTABLE_MENU_TABLE=tblrzeqWS3OaV3OtQ
MENU_REFRESH_MS=900000
